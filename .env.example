# Copy to .env and fill in. Never commit .env.

# --- Core ----------------------------------------------------------------------------------------------
# Local dev uses SQLite by default; Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./betwatch.db
# Required for /admin and /api/admin/*. Use a long random string: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me
POSTGRES_PASSWORD=change-me-too
HOME_COUNTRY=IN
DISPLAY_TIMEZONE=Asia/Kolkata

# --- Collector -----------------------------------------------------------------------------------------
# true = run the collector inside the API process (handy for a single local process; use the worker in production)
EMBEDDED_WORKER=false
SCHEDULER_TICK_SECONDS=60
# Identify your bot honestly; publishers may contact or block you by this.
USER_AGENT=BetWatchBot/1.0 (+https://your-domain.example/bot; you@your-domain.example)
RELEVANCE_FILTER=true
ENRICH_BYLINES=true
ENRICH_MAX_PER_RUN=30

# --- Optional providers (leave blank to disable) --------------------------------------------------------
# AI summaries + tone per story (Anthropic Messages API). Without it: publisher excerpts + headlines.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# YouTube search + live streams for every subject. Free quota: 10,000 units/day (one search = 100 units).
YOUTUBE_API_KEY=
# Reddit search (create a "script" app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Bluesky search (Settings -> App passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Channel Profile Providers (Task 4) ------------------------------------------------
# Meta Graph API: Instagram Business Discovery (requires a Meta App connected to an Instagram Business account)
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
# Licensed stock market data API key for listed publisher share prices
MARKET_DATA_API_KEY=
# Google Fact Check Tools API key for claims:search mentions of the publisher
FACTCHECK_API_KEY=
